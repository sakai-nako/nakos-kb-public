---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  // 親 cfp が draft の場合は校正過程ページも生成しない（親に従う）
  const drafts = await getCollection('cfp_drafts');
  const cfps = await getCollection('cfp', ({ data }) => !data.draft);
  const publicSlugs = new Set(cfps.map((c) => c.id));
  return drafts
    .filter((d) => publicSlugs.has(d.id))
    .map((draft) => ({
      params: { slug: draft.id },
      props: { draft },
    }));
}

const { draft } = Astro.props;
const { Content } = await render(draft);
const { title } = draft.data;

// 親 CFP（提出本文）への戻りリンク用
const parentCfp = await getEntry('cfp', draft.id);
const parentTitle = parentCfp?.data.title ?? '提出本文に戻る';
---

<Layout>
  <main>
    <div class="container">
      <a href={`/cfp/${draft.id}`} class="back-link">← 提出本文に戻る</a>

      <article class="drafts-detail">
        <header>
          <p class="kicker">校正過程</p>
          <h1>{title}</h1>
          <p class="parent-cfp">対応する提出本文: <a href={`/cfp/${draft.id}`}>{parentTitle}</a></p>
        </header>

        <div class="content">
          <Content />
        </div>
      </article>
    </div>
  </main>
</Layout>

<style>
  main {
    padding: 2rem;
    min-height: 100vh;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    color: #6366f1;
    text-decoration: none;
    margin-bottom: 2rem;
    font-size: 0.9rem;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .drafts-detail {
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 16px;
    padding: 2rem;
  }

  header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .kicker {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b7280;
  }

  h1 {
    font-size: 1.5rem;
    margin: 0 0 1rem;
    line-height: 1.4;
  }

  .parent-cfp {
    margin: 0;
    font-size: 0.85rem;
    color: #6b7280;
  }

  .parent-cfp a {
    color: #6366f1;
    text-decoration: none;
  }

  .parent-cfp a:hover {
    text-decoration: underline;
  }

  .content {
    line-height: 1.8;
    color: #1f2937;
  }

  .content :global(h2) {
    font-size: 1.25rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #e5e7eb;
    color: #374151;
  }

  .content :global(h3) {
    font-size: 1.05rem;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    color: #4b5563;
  }

  .content :global(p) {
    margin: 0 0 1em;
  }

  .content :global(a) {
    color: #6366f1;
  }

  .content :global(ul),
  .content :global(ol) {
    margin: 0 0 1em;
    padding-left: 1.5em;
  }

  .content :global(li) {
    margin-bottom: 0.25em;
  }

  .content :global(blockquote) {
    border-left: 3px solid #d1d5db;
    margin: 1em 0;
    padding: 0.5em 0 0.5em 1em;
    color: #4b5563;
    background: #f9fafb;
    border-radius: 0 6px 6px 0;
  }

  .content :global(code) {
    background: #f3f4f6;
    padding: 0.1em 0.3em;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .content :global(strong) {
    color: #1f2937;
  }

  /* Dark theme */
  :global(html[data-theme='dark']) .back-link {
    color: #818cf8;
  }
  :global(html[data-theme='dark']) .drafts-detail {
    background: rgba(30, 30, 30, 0.9);
    border-color: rgba(255, 255, 255, 0.1);
  }
  :global(html[data-theme='dark']) header {
    border-color: rgba(255, 255, 255, 0.1);
  }
  :global(html[data-theme='dark']) .kicker {
    color: #9ca3af;
  }
  :global(html[data-theme='dark']) h1 {
    color: #fff;
  }
  :global(html[data-theme='dark']) .parent-cfp {
    color: #9ca3af;
  }
  :global(html[data-theme='dark']) .parent-cfp a {
    color: #818cf8;
  }
  :global(html[data-theme='dark']) .content {
    color: #e5e7eb;
  }
  :global(html[data-theme='dark']) .content :global(h2) {
    border-color: rgba(255, 255, 255, 0.1);
    color: #f3f4f6;
  }
  :global(html[data-theme='dark']) .content :global(h3) {
    color: #d1d5db;
  }
  :global(html[data-theme='dark']) .content :global(blockquote) {
    border-color: #4b5563;
    background: #1f2937;
    color: #d1d5db;
  }
  :global(html[data-theme='dark']) .content :global(code) {
    background: #1f2937;
    color: #e5e7eb;
  }
  :global(html[data-theme='dark']) .content :global(strong) {
    color: #f3f4f6;
  }
</style>
