build:
    import { pathToFileURL } from 'node:url';
    const dir = String.raw`{{ source_directory() }}`;
    const { main } = await import(pathToFileURL(dir + '/scripts/tasks.ts').href);
    Deno.exit(await main(['build', ...Deno.args]));

