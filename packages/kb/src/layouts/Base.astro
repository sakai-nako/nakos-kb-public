---
import '../styles/global.css';
const { title, canonical = '/' } = Astro.props;
const siteName = "Nako's Knowledge Base";
const documentTitle = title ? `${title} | ${siteName}` : siteName;
const pathname = Astro.url.pathname;
---
<!doctype html><html lang="ja"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><link rel="canonical" href={canonical} /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><script is:inline>const stored=localStorage.getItem('kb-theme');const preference=stored==='light'||stored==='dark'||stored==='system'?stored:'system';const resolved=preference==='system'?(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):preference;document.documentElement.dataset.theme=resolved;document.documentElement.dataset.themePreference=preference;</script><title>{documentTitle}</title></head><body>
  <header class="nk-site-header">
    <div class="nk-site-header__inner">
      <a class="nk-site-brand" href="/about" aria-label={`${siteName} ホーム`}>{siteName}</a>
      <nav class="nk-site-nav" aria-label="主要なページ">
        <a href="/blog" aria-current={pathname === '/blog' || pathname.startsWith('/blog/') ? 'page' : undefined}>Blog</a>
        <a href="/about" aria-current={pathname === '/about' || pathname.startsWith('/about/') ? 'page' : undefined}>About</a>
        <a href="/events" aria-current={pathname === '/events' || pathname.startsWith('/events/') ? 'page' : undefined}>Events</a>
        <a href="/novels" aria-current={pathname === '/novels' || pathname.startsWith('/novels/') ? 'page' : undefined}>小説</a>
        <a href="/slides" aria-current={pathname === '/slides' ? 'page' : undefined}>Slides</a>
      </nav>
      <div class="nk-theme-menu" role="group" aria-label="表示テーマ">
        <!-- Native buttons are retained because the DS does not provide a theme-switcher primitive. -->
        <button type="button" data-theme-choice="system">System</button>
        <button type="button" data-theme-choice="light">Light</button>
        <button type="button" data-theme-choice="dark">Dark</button>
      </div>
    </div>
  </header>
  <main class="nk-page"><slot /></main>
<script is:inline>const setTheme=(preference)=>{localStorage.setItem('kb-theme',preference);const resolved=preference==='system'?(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):preference;document.documentElement.dataset.theme=resolved;document.documentElement.dataset.themePreference=preference;document.querySelectorAll('[data-theme-choice]').forEach((button)=>button.setAttribute('aria-pressed',String(button.dataset.themeChoice===preference)));};document.querySelectorAll('[data-theme-choice]').forEach((button)=>button.addEventListener('click',()=>setTheme(button.dataset.themeChoice)));setTheme(document.documentElement.dataset.themePreference||'system');matchMedia('(prefers-color-scheme: dark)').addEventListener('change',()=>{if(document.documentElement.dataset.themePreference==='system')setTheme('system');});</script></body></html>
