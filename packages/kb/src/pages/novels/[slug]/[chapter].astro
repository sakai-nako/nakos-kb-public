---
import Base from '../../../layouts/Base.astro'; import NovelBody from '../../../components/NovelBody.astro'; import { novels, novel } from '../../../shared/novels'; import { canonicalChapterPath, canonicalNovelPath, resolveChapterSlug, resolveNovelSlug } from '../../../shared/public-paths'; const items = novels(); export function getStaticPaths() { return novels().flatMap((item) => item.chapters.map((chapter) => ({ params: { slug: canonicalNovelPath(item).split('/').at(-1), chapter: canonicalChapterPath(item, chapter.slug).split('/').at(-1) } }))); } const resolvedNovel = resolveNovelSlug(Astro.params.slug ?? '', items); const item = resolvedNovel ? novel(resolvedNovel) : null; const resolvedChapter = item ? resolveChapterSlug(item, Astro.params.chapter ?? '') : null; const chapter = item?.chapters.find((value) => value.slug === resolvedChapter); if (!item || !chapter) return Astro.redirect('/404'); const position = item.chapters.indexOf(chapter);
---
<Base title={chapter.title} canonical={canonicalChapterPath(item, chapter.slug)}><article class="nk-reading"><a class="nk-back-link" href={canonicalNovelPath(item)}>目次へ戻る</a><p class="nk-eyebrow">Chapter {chapter.sequence}</p><h1>{chapter.title}</h1><NovelBody body={chapter.body} /><nav class="chapter-navigation" aria-label="章の移動">{position > 0 && <a href={canonicalChapterPath(item, item.chapters[position - 1].slug)}>前の章</a>} {position < item.chapters.length - 1 && <a href={canonicalChapterPath(item, item.chapters[position + 1].slug)}>次の章</a>}</nav></article></Base>
