---
import Base from '../../layouts/Base.astro';
import { isTalk, presentations, roleLabel } from '../../shared/event-view';
import { type Event, events, formatJst } from '../../shared/events';
import { eventPath, slidesPath } from '../../shared/public-paths';
import { decksForEvent } from '../../shared/slides';
const items = events();
const groups = [
  { id: 'talks', title: '登壇したイベント', items: items.filter((item) => isTalk(item)) },
  { id: 'others', title: 'その他のイベント', items: items.filter((item) => !isTalk(item)) },
].filter((group) => group.items.length > 0);
const talkTitles = (item: Event) =>
  presentations(
    item.materials,
    decksForEvent(item.id).map((deck) => ({ title: deck.title, href: slidesPath(deck.id) })),
  ).map((talk) => talk.title);
---
<Base title="Events" canonical="/events">
  <section>
    <p class="nk-eyebrow">Events</p>
    <h1>イベント・カンファレンス参加履歴</h1>
    {groups.length ? groups.map((group) => (
      <section id={group.id}>
        <h2>{group.title}</h2>
        <ul class="nk-card-grid" role="list">
          {group.items.map((item) => (
            <li class="nk-card">
              <p class="nk-card__meta">{formatJst(item.start_datetime, 'date')} {formatJst(item.start_datetime, 'time')} - {formatJst(item.end_datetime, 'time')}</p>
              <a class="nk-card__title" href={eventPath(item.id)}>{item.event_name}</a>
              {item.how_relate.length > 0 && <ul class="nk-chip-list" role="list">{item.how_relate.map((tag) => <li class="nk-chip">{roleLabel(tag)}</li>)}</ul>}
              {talkTitles(item).length > 0 && <p class="nk-card__desc">発表: {talkTitles(item).join('、')}</p>}
            </li>
          ))}
        </ul>
      </section>
    )) : <p>公開済みのイベントはまだありません。</p>}
  </section>
</Base>
